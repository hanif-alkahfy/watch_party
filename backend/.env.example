# Copy to .env and fill in. Never commit .env.
PORT=3001

# Default admin credentials for seeder
ADMIN_EMAIL=admin@mail.com
ADMIN_PASSWORD=admin123

# Required. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=24h

DB_PATH=./data/watchparty.db
MEDIA_ROOT=./media
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
FFMPEG_PATH=ffmpeg
MAX_UPLOAD_MB=512

# Built frontend to serve. Empty = API only (the Vite dev server serves it).
WEB_ROOT=
PUBLIC_BASE_URL=

# Address to bind. ":3001" = every interface, so other devices on the local
# network can reach the app.
LISTEN_ADDR=:3001
